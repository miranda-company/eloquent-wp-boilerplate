# Local app runtime
logs/

# WordPress core and generated/runtime files
app/public/*
!app/public/wp-content/
app/public/wp-content/*
!app/public/wp-content/plugins/
!app/public/wp-content/themes/

# Keep the internal blueprint plugin stack.
app/public/wp-content/plugins/*
!app/public/wp-content/plugins/advanced-custom-fields/
!app/public/wp-content/plugins/create-block-theme/
!app/public/wp-content/plugins/fluentform/
!app/public/wp-content/plugins/generateblocks/
!app/public/wp-content/plugins/generateblocks-pro/
!app/public/wp-content/plugins/generatecloud/
!app/public/wp-content/plugins/search-filter/
!app/public/wp-content/plugins/wp-optimize/
!app/public/wp-content/plugins/wp-svg-images/

# Keep the blueprint theme only.
app/public/wp-content/themes/*
!app/public/wp-content/themes/llummio-blueprint/

# Generated/runtime folders.
app/public/wp-content/cache/
app/public/wp-content/wpo-cache/
app/public/wp-content/upgrade/
app/public/wp-content/upgrade-temp-backup/
app/public/wp-content/uploads/

# Old unused font files.
app/public/wp-content/themes/llummio-blueprint/assets/fonts/Lexend*.ttf

# OS/editor noise
.DS_Store
Thumbs.db
*.log

# Local packaging helpers
.blueprint-package-*/
llummio-wp-blueprint-prepared-*.zip
